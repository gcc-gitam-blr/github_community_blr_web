# Leave the Supabase values empty to run Epoch in single-browser demo mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Force Epoch on or off regardless of dates: live | off  (leave empty to follow dates)
NEXT_PUBLIC_EPOCH_MODE=

# Demo mode only: code that unlocks the organiser desk. Change it!
NEXT_PUBLIC_EPOCH_ORGANISER_CODE=epoch-admin

# Optional: your custom domain. On Vercel this is filled in automatically from the production domain.
NEXT_PUBLIC_SITE_URL=
