# Leave the Supabase values empty to run Epoch in single-browser demo mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Force Epoch on or off regardless of dates: live | off  (leave empty to follow dates)
NEXT_PUBLIC_EPOCH_MODE=

# Demo mode only: code that unlocks the organiser desk. Change it!
NEXT_PUBLIC_EPOCH_ORGANISER_CODE=epoch-admin

# Optional: your custom domain. On Vercel this is filled in automatically from the production domain.
NEXT_PUBLIC_SITE_URL=

# Cookie-free Vercel Web Analytics + Speed Insights. Turn them on in the Vercel dashboard first, then set this to "on".
NEXT_PUBLIC_ANALYTICS=

# --- Email (welcome email + organiser broadcasts). Leave empty and the site simply doesn't send email. ---
# Who the email is from. Must be the Gmail address below, or an address on your verified Resend domain.
EMAIL_FROM=github_community@gitam.in
# Option A — a normal Gmail account with an App Password (works for anyone, no domain needed):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Option B — Resend (needs a verified domain): RESEND_API_KEY=
RESEND_API_KEY=
# Any long random text. Signs the unsubscribe links. Make one at https://generate-secret.vercel.app/32
EMAIL_SECRET=

# Local only, used by `npm run connect` to create the tables. Never add this to Vercel.
SUPABASE_DB_URL=
